// use prisma-8
enum Role {
  admin
  teacher
  family
}

enum Status {
  active
  banned
  suspended
}
model User {
  id                  String            @id @default(uuid())
  name                String
  email               String            @unique
  phone               String
  password            String
  passwordLastChanged TimestamptzString @default(now())
  role                Role              @default(family)
  createdAt           TimestamptzString @default(now())
  updatedAt           TimestamptzString @default(now())
  status              Status            @default(active)
  subject             String            @default("Quran")
  // Set when the user proves ownership of `email` (verification link or a
  // completed password reset). NULL = not verified yet.
  emailVerifiedAt     TimestamptzString?

  @@index([role])
}

enum AuthTokenType {
  password_reset
  email_verification
}

// One-time, expiring tokens for password reset and email verification.
// Only a SHA-256 hash of the token is stored, so a database leak does not
// yield usable links. A token is consumed by deleting its row (single use).
model AuthToken {
  id        String            @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String            @unique
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  user      User              @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// Generic atomic counters used for login lockout and endpoint rate limits.
// `key` encodes scope + subject (e.g. "login:pair:<sha256>"), and identifiers
// are hashed so no raw email/IP is stored. All updates go through single
// INSERT .. ON CONFLICT statements (see lib/auth/rateLimit.ts) so concurrent
// requests can never lose an increment.
model AuthRateLimit {
  key          String             @id
  count        Int                @default(0)
  windowStart  TimestamptzString  @default(now())
  blockedUntil TimestamptzString?
  updatedAt    TimestamptzString  @default(now())

  @@index([updatedAt])
}

enum TeacherReward {
  EXCELLENT
  VERY_GOOD
  GOOD
  NEUTRAL
  NOT_BAD
  POOR
  VERY_POOR
  TERRIBLE
}

model Lesson {
  id            String            @id @default(uuid())
  teacherId     String
  familyId      String
  student       String
  status        String
  classDate     TimestamptzString
  money         Int
  duration      Int //['15', '30', '45', '60', '75', '90', '120'] 
  TeacherReward TeacherReward     @default(GOOD)
  createdAt     TimestamptzString @default(now())
  updatedAt     TimestamptzString @default(now())

  teacher       User              @relation(fields:[teacherId], references:[id], "TeacherLesson")
  family        User              @relation(fields:[familyId], references:[id], "FamilyLesson")

  @@index([familyId])
  @@index([teacherId])
  @@index([classDate])
  @@index([createdAt])
}

model TeacherFamily {
  id        String   @id @default(uuid())
  teacherId String
  familyId  String

  teacher   User     @relation(fields:[teacherId], references:[id], "Teacher")
  family    User     @relation(fields:[familyId], references:[id], "Family")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([teacherId, familyId])
}

model MoneyPerLesson {
  id        String @id @default(uuid())
  money     Int    @default(0)
  teacherId String @unique
  teacher   User   @relation(fields:[teacherId], references:[id], "Teacher")
}


model Contact {
  id        String   @id @default(uuid())
  email     String
  name      String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt     TimestamptzString @default(now())
  updatedAt     TimestamptzString @default(now())

  @@index([isRead])
  @@index([createdAt])
}