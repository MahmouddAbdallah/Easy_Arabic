// use prisma-8
enum Role {
  admin
  teacher
  family
}

enum Status {
  active
  banned
  suspended
}

model User {
  id                  String             @id @default(uuid())
  name                String
  email               String             @unique
  phone               String?
  password            String
  passwordLastChanged TimestamptzString  @default(now())
  role                Role               @default(family)
  createdAt           TimestamptzString  @default(now())
  updatedAt           TimestamptzString  @default(now())
  status              Status             @default(active)
  subject             String             @default("Quran")

  imageUrl            String?
  // Set when the user proves ownership of `email` (verification link or a
  // completed password reset). NULL = not verified yet.
  emailVerifiedAt     TimestamptzString?

  @@index([role])
}

enum AuthTokenType {
  password_reset
  email_verification
}

// One-time, expiring tokens for password reset and email verification.
// Only a SHA-256 hash of the token is stored, so a database leak does not
// yield usable links. A token is consumed by deleting its row (single use).
model AuthToken {
  id        String            @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String            @unique
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  user      User              @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// Generic atomic counters used for login lockout and endpoint rate limits.
// `key` encodes scope + subject (e.g. "login:pair:<sha256>"), and identifiers
// are hashed so no raw email/IP is stored. All updates go through single
// INSERT .. ON CONFLICT statements (see lib/auth/rateLimit.ts) so concurrent
// requests can never lose an increment.
model AuthRateLimit {
  key          String             @id
  count        Int                @default(0)
  windowStart  TimestamptzString  @default(now())
  blockedUntil TimestamptzString?
  updatedAt    TimestamptzString  @default(now())

  @@index([updatedAt])
}

model UserFCMToken {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields:[userId], references:[id], onDelete: Cascade)
  fcmToken   String
  deviceType String? // "Chrome on Windows" or "Mobile"
  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())

  @@unique([userId, fcmToken])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Profile change requests (customer -> admin)
//
// A family whose profile is locked (it has a teacher, or its account is 6+ months
// old) - or who wants to change an admin-controlled field (email / phone) - asks
// the admin instead of editing directly. See lib/profile/.
// ---------------------------------------------------------------------------
enum ProfileChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED // withdrawn by the customer while still pending
}

model ProfileChangeRequest {
  id               String                     @id @default(uuid())
  familyId         String
  status           ProfileChangeRequestStatus @default(PENDING)

  // Structured payload, validated by lib/profile/schemas.ts on the way in AND out.
  // Both objects share the same keys (name | email | phone | subject):
  //   requestedChanges - what the customer wants the fields to become
  //   currentValues    - what those fields held when the request was submitted
  requestedChanges Json
  currentValues    Json
  // Free-text explanation from the customer (optional).
  reason           String?

  // Review audit trail. All three stay NULL until an admin decides.
  reviewedById     String?
  reviewedAt       TimestamptzString?
  adminNote        String?

  createdAt        TimestamptzString          @default(now())
  updatedAt        TimestamptzString          @default(now())

  family           User                       @relation(fields:[familyId], references:[id], onDelete: Cascade, "ProfileRequestFamily")
  reviewer         User?                      @relation(fields:[reviewedById], references:[id], onDelete: SetNull, "ProfileRequestReviewer")

  @@index([familyId, createdAt])
  @@index([status, createdAt])
  // A family can have at most ONE pending request. Enforced by the database, so two
  // simultaneous submissions cannot both succeed (the loser gets a unique violation).
  @@index([familyId], unique: true, where: "(status = 'PENDING')", name: "profileChangeRequest_one_pending")
}

enum TeacherReward {
  EXCELLENT
  VERY_GOOD
  GOOD
  NEUTRAL
  NOT_BAD
  POOR
  VERY_POOR
  TERRIBLE
}

model Lesson {
  id            String            @id @default(uuid())
  teacherId     String
  familyId      String
  student       String
  status        String
  classDate     TimestamptzString
  money         Int
  duration      Int //['15', '30', '45', '60', '75', '90', '120'] 
  TeacherReward TeacherReward     @default(GOOD)
  createdAt     TimestamptzString @default(now())
  updatedAt     TimestamptzString @default(now())

  teacher       User              @relation(fields:[teacherId], references:[id], "TeacherLesson")
  family        User              @relation(fields:[familyId], references:[id], "FamilyLesson")

  @@index([familyId])
  @@index([teacherId])
  @@index([classDate])
  @@index([createdAt])
}

model TeacherFamily {
  id        String            @id @default(uuid())
  teacherId String
  familyId  String

  teacher   User              @relation(fields:[teacherId], references:[id], "Teacher")
  family    User              @relation(fields:[familyId], references:[id], "Family")

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  @@unique([teacherId, familyId])
}

model MoneyPerLesson {
  id        String @id @default(uuid())
  money     Int    @default(0)
  teacherId String @unique
  teacher   User   @relation(fields:[teacherId], references:[id], "Teacher")
}

model Contact {
  id        String            @id @default(uuid())
  email     String
  name      String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean           @default(false)
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Public Contact page content (edited at /dashboard/contact/contact-info).
// Not to be confused with `Contact`, which stores inbound form submissions.
// ---------------------------------------------------------------------------

// Singleton: exactly one row, always id = 'default' (enforced by the check
// below). Every column is one concrete piece of information shown on /contact.
model ContactInfo {
  id                       String            @id

  // Hero
  heroBadgeText            String
  heroHeadline             String
  heroDescription          String

  // Phone
  phoneLabel               String
  phoneNumber              String
  phoneNote                String

  // Support email
  supportEmailLabel        String
  supportEmail             String
  supportEmailNote         String

  // Billing email (hidden on the page when empty)
  billingEmail             String?

  // WhatsApp (the whole callout is hidden when `whatsappNumber` is empty)
  whatsappNumber           String? // digits only, with country code
  whatsappTitle            String
  whatsappDescription      String
  whatsappButtonLabel      String
  whatsappPrefilledMessage String

  // Office address + map pin
  officeName               String
  addressLine1             String
  addressLine2             String?
  city                     String
  stateRegion              String?
  postalCode               String?
  country                  String
  latitude                 Float
  longitude                Float

  // Business hours settings (the per-day rows live in ContactBusinessHour)
  timezone                 String // IANA zone, e.g. "Africa/Cairo"
  businessHoursNote        String

  // Support promises shown in the highlights strip
  responseTime             String
  supportLanguages         String
  trialLessonText          String

  // Contact form copy
  formTitle                String
  formDescription          String
  formSuccessTitle         String
  formSuccessMessage       String

  // FAQ section header (the questions live in ContactFaq)
  faqTitle                 String
  faqDescription           String

  // Social profiles (a link is hidden when empty)
  facebookUrl              String?
  instagramUrl             String?
  linkedinUrl              String?
  xUrl                     String?
  whatsappUrl              String? // https://wa.me/… (or whatsapp.com) profile / chat link

  // Section visibility on the public /contact page, one flag per dashboard
  // section (true = shown, false = hidden). Defaults to shown.
  showContentSection       Boolean           @default(true)
  showChannelsSection      Boolean           @default(true)
  showLocationSection      Boolean           @default(true)
  showHoursSection         Boolean           @default(true)
  showSocialSection        Boolean           @default(true)
  showFaqsSection          Boolean           @default(true)

  updatedAt                TimestamptzString @default(now())

  @@check(expression: "id = 'default'", name: "contact_info_singleton")
}

// One row per weekday. dayOfWeek: 0 = Sunday … 6 = Saturday.
// opensAt / closesAt are 24h "HH:MM" and only meaningful while isOpen = true.
model ContactBusinessHour {
  id        String            @id @default(uuid())
  dayOfWeek Int               @unique
  isOpen    Boolean           @default(true)
  opensAt   String?
  closesAt  String?
  updatedAt TimestamptzString @default(now())

  @@check(expression: "\"dayOfWeek\" BETWEEN 0 AND 6", name: "contact_business_hour_day_range")
}

model ContactFaq {
  id          String            @id @default(uuid())
  question    String
  answer      String
  sortOrder   Int               @default(0)
  isPublished Boolean           @default(true)
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())

  @@index([sortOrder])
}
